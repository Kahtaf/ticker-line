# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Wrangler reads .env for local dev and tests (a .dev.vars file, if present,
# takes precedence), and the deploy scripts upload it with --secrets-file.
# Deploys upload every key listed here, so delete any line you leave blank
# rather than overwriting a deployed secret with an empty value.
# Only providers listed in PROVIDER_ORDER (wrangler.jsonc vars, default
# sifting,lse) need a key.
LSE_API_KEY=
SIFTING_API_KEY=
